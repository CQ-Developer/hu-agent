{
  "name": "hu-agent-management-ui",
  "version": "0.1.0",
  "private": true,
  "description": "hu-agent 管理台（Vite + React + Ant Design）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check": "npm run typecheck && node scripts/i18n-check.mjs && node scripts/api-check.mjs && vite build",
    "api:gen": "npx --yes openapi-typescript@7 ../openapi/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.5",
    "i18next": "^26.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.19",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "rollup": "4.64.5"
  },
  "license": "Apache-2.0",
  "author": "CQ-Developer"
}
