{
  "uid": "huagent-api-golden",
  "title": "hu-agent / API 黄金指标",
  "tags": ["hu-agent", "api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求速率（按状态码）",
      "datasource": { "type": "prometheus", "uid": "huagent-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(huagent_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx 比例",
      "datasource": { "type": "prometheus", "uid": "huagent-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "huagent:http_error_ratio5m", "legendFormat": "5xx ratio" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 0.2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "延迟分位（P50 / P95 / P99）",
      "datasource": { "type": "prometheus", "uid": "huagent-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(huagent_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(huagent_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(huagent_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 4,
      "type": "table",
      "title": "最慢路由 P95（Top 10）",
      "datasource": { "type": "prometheus", "uid": "huagent-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum(rate(huagent_http_request_duration_seconds_bucket[5m])) by (le, path)))",
          "legendFormat": "{{path}}",
          "instant": true,
          "format": "table"
        }
      ],
      "options": { "showHeader": true }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "采集状态",
      "datasource": { "type": "prometheus", "uid": "huagent-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "targets": [{ "refId": "A", "expr": "up{job='hu-agent-api'}", "legendFormat": "{{instance}}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "构建版本 / 已应用 schema",
      "datasource": { "type": "prometheus", "uid": "huagent-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "huagent_build_info", "legendFormat": "{{version}} · {{schema_version}}" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none" }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "累计请求数",
      "datasource": { "type": "prometheus", "uid": "huagent-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "targets": [{ "refId": "A", "expr": "sum(huagent_http_requests_total)", "legendFormat": "requests" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none" }
    }
  ]
}
